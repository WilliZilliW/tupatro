{
  "name": "tupatro",
  "version": "1.0.0",
  "description": "Tuppi x Balatro - the Finnish trick-taking game tuppi in a roguelike deckbuilder structure. One HTML file, no dependencies.",
  "keywords": [
    "tuppi",
    "balatro",
    "card-game",
    "trick-taking",
    "roguelike",
    "deckbuilder",
    "browser-game",
    "vanilla-js"
  ],
  "license": "MIT",
  "author": "Vili Seppänen",
  "private": false,
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node test/run.js",
    "start": "python3 serve.py",
    "lint": "eslint src test build.js",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"test/**/*.js\" build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  }
}
